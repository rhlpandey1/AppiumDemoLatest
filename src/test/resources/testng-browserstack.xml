<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="BrowserStack Test Suite">
    <listeners>
        <listener class-name="listeners.ScreenshotListener"/>
    </listeners>
    <test name="BrowserStack Android Tests">

        <parameter name="environment" value="BROWSERSTACK"/>
        <parameter name="platform" value="ANDROID"/>

        <classes>
            <class name="tests.BrowserStackAndroidTest"/>
        </classes>

    </test>

</suite>